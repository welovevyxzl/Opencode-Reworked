{
  "name": "opencode-remote",
  "version": "1.0.0",
  "description": "Reliable Discord remote-control system for OpenCode",
  "main": "dist/cli/index.js",
  "type": "module",
  "bin": {
    "ocr": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/index.js start",
    "dev": "tsx src/cli/index.ts start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "discord",
    "remote",
    "bot"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.25",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.7",
    "undici": "^7.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "eslint": "^9.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
